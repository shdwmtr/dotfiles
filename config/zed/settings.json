{
    "proxy": "",
    "default_open_behavior": "new_window",
    "use_system_path_prompts": false,
    "use_system_prompts": true,
    // "format_on_save": "on",
    // "formatter": "language_server",
    "tab_bar": {
        "show_pinned_tabs_in_separate_row": false,
        "show": true,
    },
    "preview_tabs": {
        "enabled": true,
    },
    "debugger": {
        "button": true,
    },
    "terminal": {
        "button": true,
    },
    "status_bar": {
        "active_language_button": true,
    },
    "title_bar": {
        "show_branch_status_icon": false,
    },
    "agent_servers": {
        "claude-acp": {
            "favorite_config_option_values": {
                "mode": [
                    "bypassPermissions"
                ],
            },
            "default_config_options": {
                "mode": "bypassPermissions",
            },
            "type": "registry",
        },
    },
    "tabs": {
        "file_icons": false,
        "git_status": false,
    },
    "edit_predictions": {
        "provider": "none",
    },
    "diff_view_style": "split",
    "ssh_connections": [
        {
            "host": "marley",
            "args": [],
            "projects": [
                {
                    "paths": [
                        "/home/ubuntu"
                    ],
                },
            ],
        },
    ],
    "buffer_line_height": "comfortable",
    "cli_default_open_behavior": "new_window",
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "agent_buffer_font_size": 13.0,
    "agent_ui_font_size": 15.0,
    "git": {
        "disable_git": false,
        "enable_diff": true,
        "enable_status": true,
        "show_stage_restore_buttons": true,
        "path_style": "file_name_first",
        "hunk_style": "staged_hollow",
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": true,
        },
    },
    "project_panel": {
        "button": true,
        "hide_root": false,
        "bold_folder_labels": false,
        "auto_fold_dirs": true,
        "auto_reveal_entries": true,
        "hide_gitignore": false,
        "git_status_indicator": false,
        "dock": "left",
        "git_status": true,
    },
    "scrollbar": {
        "git_diff": false,
    },
    "inline_code_actions": true,
    "relative_line_numbers": "disabled",
    "gutter": {
        "runnables": true,
        "breakpoints": true,
        "folds": true,
        "line_numbers": true,
    },
    "disable_ai": false,
    "agent": {
        "dock": "right",
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-5-mini",
        },
        "inline_assistant_model": {
            "provider": "copilot_chat",
            "model": "claude-sonnet-4.5",
        },
        "model_parameters": [],
    },
    "icon_theme": "Colored Zed Icons Theme Dark",
    "git_panel": {
        "diff_stats": true,
        "show_count_badge": false,
        "file_icons": true,
        "tree_view": false,
        "collapse_untracked_diff": false,
        "dock": "left",
        "button": true,
        "status_style": "icon",
    },
    "ui_font_family": "JetBrainsMono Nerd Font Mono",
    "buffer_font_family": "JetBrainsMono Nerd Font Mono",
    "buffer_font_weight": 400.0,
    "base_keymap": "VSCode",
    "minimap": {
        "show": "never",
    },
    "file_types": {},
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "ui_font_size": 16.0,
    "buffer_font_size": 15.0,
    "theme": {
        "mode": "dark",
        "light": "VSCode Dark Modern",
        "dark": "VSCode Dark Modern",
    },
    "languages": {
        "C++": {
            "format_on_save": "on",
            "formatter": "language_server",
        },
        "C": {
            "format_on_save": "on",
            "formatter": "language_server",
        },
    },
    "tab_size": 4
}
